# Database Configuration
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=recommand_db
MARIADB_USER=recommand_user
MARIADB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
PORT=8000
LOG_LEVEL=INFO

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Frontend URL (CORS 허용 및 OAuth redirect 기준)
FRONTEND_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth (https://developers.kakao.com)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver OAuth (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
